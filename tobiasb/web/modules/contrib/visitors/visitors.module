<?php

/**
 * @file
 * Logs visitors for your site.
 */

use Drupal\Core\DependencyInjection\ContainerInjectionInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\node\NodeInterface;
use Drupal\visitors\Hook\CounterHooks;
use Drupal\visitors\Hook\CronHooks;
use Drupal\visitors\Hook\HelpHooks;
use Drupal\visitors\Hook\PageAttachmentsHooks;
use Drupal\visitors\Hook\SearchHooks;
use Drupal\visitors\Hook\TokenHooks;
use Drupal\visitors\Hook\UserHooks;
use Drupal\visitors\Hook\ViewsHooks;

/**
 * Returns a hook class, instantiating directly when unavailable.
 *
 * Unit tests typically register only the services they exercise directly and
 * omit the hook-class service. This helper falls back to a plain instantiation
 * so that module-wrapper functions remain testable in those contexts.
 *
 * @param class-string<T> $class
 *   The hook class to load.
 *
 * @return T
 *   The hook class instance.
 *
 * @template T of object
 */
function _visitors_hook(string $class): object {
  if (\Drupal::hasService($class)) {
    return \Drupal::service($class);
  }
  if (is_subclass_of($class, ContainerInjectionInterface::class)) {
    return $class::create(\Drupal::getContainer());
  }
  return new $class();
}

/**
 * Implements hook_help().
 */
#[LegacyHook]
function visitors_help($route_name, $route_match) {
  return _visitors_hook(HelpHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_cron().
 */
#[LegacyHook]
function visitors_cron(): void {
  _visitors_hook(CronHooks::class)->cron();
}

/**
 * Implements hook_page_attachments().
 */
#[LegacyHook]
function visitors_page_attachments(array &$page) {
  _visitors_hook(PageAttachmentsHooks::class)->pageAttachments($page);
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Allow users to decide if tracking code will be added to pages or not.
 */
#[LegacyHook]
function visitors_form_user_form_alter(&$form, FormStateInterface $form_state) {
  _visitors_hook(UserHooks::class)->formUserFormAlter($form, $form_state);
}

/**
 * Submit callback for user profile form to save the Visitor setting.
 */
function visitors_user_profile_form_submit($form, FormStateInterface $form_state) {
  if (!$form_state->hasValue('user_account_users')) {
    return;
  }
  /** @var \Drupal\user\AccountForm $user_form */
  $user_form = $form_state->getFormObject();
  /** @var \Drupal\user\UserInterface $account */
  $account = $user_form->getEntity();

  $value = (int) $form_state->getValue('user_account_users');
  \Drupal::service('user.data')
    ->set('visitors', $account->id(), 'user_account_users', $value);
}

/**
 * Implements hook_node_links_alter().
 */
#[LegacyHook]
function visitors_node_links_alter(array &$links, NodeInterface $entity, array &$context) {
  return _visitors_hook(CounterHooks::class)->nodeLinksAlter($links, $entity, $context);
}

/**
 * Implements hook_entity_delete().
 */
#[LegacyHook]
function visitors_entity_delete(EntityInterface $entity) {
  _visitors_hook(CounterHooks::class)->entityDelete($entity);
}

/**
 * Implements hook_ranking().
 *
 * @see hook_node_search_ranking()
 */
#[LegacyHook]
function visitors_ranking() {
  return _visitors_hook(SearchHooks::class)->ranking();
}

/**
 * Implements hook_node_search_ranking().
 *
 * Used by the search_node submodule introduced in Drupal 11.4.
 *
 * @see hook_ranking()
 */
#[LegacyHook]
function visitors_node_search_ranking() {
  return _visitors_hook(SearchHooks::class)->ranking();
}

/**
 * Implements hook_views_data().
 */
#[LegacyHook]
function visitors_views_data() {
  return _visitors_hook(ViewsHooks::class)->viewsData();
}

/**
 * Implements hook_token_info().
 */
#[LegacyHook]
function visitors_token_info() {
  return _visitors_hook(TokenHooks::class)->tokenInfo();
}

/**
 * Implements hook_tokens().
 */
#[LegacyHook]
function visitors_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata) {
  return _visitors_hook(TokenHooks::class)->tokens($type, $tokens, $data, $options, $bubbleable_metadata);
}
